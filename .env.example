# ---------------------------------------------------------------------------
# MoovVert — variables d'environnement (EXEMPLES, ne jamais commiter de secrets)
# Backend (Render) : renseigner ces variables dans Render > Environment.
# Frontend (Vercel) : seule VITE_API_URL est nécessaire côté Vercel.
# ---------------------------------------------------------------------------

# Port d'écoute. Render injecte automatiquement PORT : ne pas le fixer là-bas.
PORT=3000

# NODE_ENV=production sur Render (requis pour servir le mode production).
NODE_ENV=production

# Origine(s) autorisée(s) par CORS — votre domaine Vercel (sans slash final).
# Plusieurs origines possibles, séparées par des virgules (ex. previews Vercel).
# Exemple : FRONTEND_URL=https://moovvert.vercel.app
FRONTEND_URL=https://votre-app.vercel.app

# --- Gmail SMTP (envoi réel des codes de vérification) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application-google
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=votre-adresse@gmail.com
MAIL_FROM_NAME=MoovVert

# --- Frontend (Vercel uniquement) ---
# URL publique du backend Render, SANS slash final. Exemple :
# VITE_API_URL=https://moovvert-api.onrender.com
VITE_API_URL=https://votre-api.onrender.com

# --- Clés existantes (conservées) ---
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
